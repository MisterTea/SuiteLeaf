{
  "name": "suiteleaf",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev -w @suiteleaf/web",
    "dev:desktop": "npm run dev -w @suiteleaf/desktop",
    "build": "npm run build -w @suiteleaf/web && npm run build -w @suiteleaf/desktop",
    "build:web": "npm run build -w @suiteleaf/web",
    "build:desktop": "npm run build -w @suiteleaf/desktop",
    "package:desktop": "npm run package -w @suiteleaf/desktop",
    "typecheck": "tsc --noEmit -p apps/web && tsc --noEmit -p apps/desktop && tsc --noEmit -p packages/core && tsc --noEmit -p services/auth && tsc --noEmit -p services/ai",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:desktop": "playwright test --project=chromium",
    "test:e2e:mobile": "playwright test --project=mobile",
    "test:e2e:responsive": "playwright test tests/browser/responsive.spec.ts",
    "test:electron": "playwright test --config playwright.electron.config.ts",
    "notices": "node scripts/notices.mjs",
    "setup:electron": "node node_modules/electron/install.js",
    "format": "prettier --write apps/*/src packages/*/src services/*/src services/*/test tests",
    "test:office-corpus": "node scripts/verify-office-imports.mjs",
    "build:auth": "npm run build -w @suiteleaf/auth",
    "build:ai": "npm run build -w @suiteleaf/ai",
    "build:node": "cargo build --release -p suiteleaf-node",
    "test:rust": "cargo test --workspace",
    "storyboards": "playwright test --config playwright.storyboards.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jszip": "^3.4.0",
    "@types/node": "^24.0.0",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@types/localforage": "^0.0.33",
    "localforage": "^1.10.0"
  },
  "overrides": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
