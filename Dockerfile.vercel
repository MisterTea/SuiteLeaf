FROM rust:1-slim-bookworm AS chef
RUN apt-get update && apt-get install -y --no-install-recommends pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*
RUN cargo install cargo-chef --locked --version 0.1.78
WORKDIR /src

FROM chef AS planner
COPY Cargo.toml Cargo.lock ./
COPY crates crates
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS rust
# The recipe changes only with dependency manifests, not application edits.
COPY --from=planner /src/recipe.json recipe.json
RUN cargo chef cook --locked --release --package suiteleaf-node --recipe-path recipe.json
COPY Cargo.toml Cargo.lock ./
COPY crates crates
COPY services/auth/schema.json services/auth/schema.json
RUN cargo build --locked --release -p suiteleaf-node

FROM node:24-bookworm-slim AS web
WORKDIR /src
ENV ELECTRON_SKIP_BINARY_DOWNLOAD=1 NODE_LLAMA_CPP_SKIP_DOWNLOAD=true
COPY package.json package-lock.json ./
COPY apps/desktop/package.json apps/desktop/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/core/package.json packages/core/package.json
COPY services/ai/package.json services/ai/package.json
COPY services/auth/package.json services/auth/package.json
RUN npm ci --no-audit --no-fund --workspace=@suiteleaf/web --workspace=@suiteleaf/core --workspace=@suiteleaf/auth --include-workspace-root && npm cache clean --force
COPY packages/supermail/package.json packages/supermail/package-lock.json packages/supermail/
# SuiteMail has an independent lockfile; install outside the root workspaces.
RUN npm ci --prefix packages/supermail --workspaces=false --no-audit --no-fund && npm cache clean --force
COPY apps/web apps/web
COPY packages/core packages/core
COPY packages/supermail/src packages/supermail/src
COPY services services
ENV VITE_SUITELEAF_SERVER=1
# V8 otherwise defaults to a 2 GiB heap in the Standard builder's container.
# Cap the V8 heap at 3.5 GiB and expose GC so Vite reclaims transform ASTs
# before Rollup and esbuild render and minify chunks in the 8 GiB builder.
RUN GOMAXPROCS=2 NODE_OPTIONS="--max-old-space-size=3584 --expose-gc" npm run build:web
RUN npm run build:auth

FROM node:24-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libssl3 && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/suiteleaf
COPY --from=rust /src/target/release/suiteleaf-node /usr/local/bin/suiteleaf-node
COPY --from=web /src/apps/web/dist ./web
COPY --from=web /src/services/auth/dist/server.mjs ./auth/server.mjs
COPY deploy/cloud.toml ./cloud.toml
ENV SUITELEAF_CLOUD=1 PORT=80
EXPOSE 80
ENTRYPOINT ["suiteleaf-node", "run", "--config", "/opt/suiteleaf/cloud.toml"]
